PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB=proveraai

REDIS_URL=redis://localhost:6379

# Auth. JWT_ACCESS_SECRET must be at least 32 random characters, generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-value-of-32-chars-or-more
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Secure cookies work on http://localhost in modern browsers; keep true
COOKIE_SECURE=true
# lax when the frontend and API share a parent domain (app.x / api.x)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# Number of proxies in front of the app (1 behind a host's load balancer)
TRUST_PROXY=0

# First administrator, created on startup while no admin exists. Set both for
# the first boot, then remove them. Password: 12 to 128 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional, defaults to "Administrator"
ADMIN_FULL_NAME=

# Optional: https://observe.nestjs.com
# Leave empty unless the security analyst has signed off: Observe is an external
# service and the threat assessment assumes no third-party integrations.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
